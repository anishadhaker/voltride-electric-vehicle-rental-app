# Server Configuration
PORT=5000

# MongoDB Database Connection URL
MONGODB_URI=mongodb://127.0.0.1:27017/voltride

# Security Secret for JWT Authentication
JWT_SECRET=voltride_development_jwt_secret_key_2026

# Development-only admin provisioning values. Never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=

# Password reset email delivery
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Use json only for local transport testing; it does not deliver email.
# EMAIL_TRANSPORT=json
