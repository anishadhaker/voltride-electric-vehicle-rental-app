# Server Configuration
PORT=5000

# MongoDB Atlas Connection URL (replace with your real values)
MONGODB_URI=mongodb+srv://<username>:<password>@voltridecluster.2gkeaj6.mongodb.net/voltride?retryWrites=true&w=majority&appName=VoltRideCluster

# Security Secret for JWT Authentication
JWT_SECRET=replace_with_a_secure_jwt_secret
JWT_EXPIRES_IN=7d

# Cloudinary vehicle image storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin credentials
ADMIN_NAME=your_admin_name
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_MOBILE=your_admin_mobile
ADMIN_PASSWORD=replace_with_secure_admin_password

# Gmail + Nodemailer password reset email delivery
# NOTE: EMAIL_APP_PASSWORD is a Google App Password (16 characters), NOT your normal Gmail password.
EMAIL_USER=your_voltride_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_google_app_password

# Development-only admin provisioning values. Never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=

