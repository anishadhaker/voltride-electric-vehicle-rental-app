# Server Configuration
PORT=5000

# MongoDB Atlas Connection URL (replace with your real values)
MONGODB_URI=mongodb+srv://<username>:<password>@voltridecluster.2gkeaj6.mongodb.net/voltride?retryWrites=true&w=majority&appName=VoltRideCluster

# Security Secret for JWT Authentication
JWT_SECRET=replace_with_a_secure_jwt_secret
JWT_EXPIRES_IN=7d

# Admin credentials
ADMIN_NAME=your_admin_name
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_MOBILE=your_admin_mobile
ADMIN_PASSWORD=replace_with_secure_admin_password

# Email / OTP credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=replace_with_email_app_password
EMAIL_FROM=VoltRide <your_email@example.com>

# Development-only admin provisioning values. Never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=

# Password reset email delivery
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Use json only for local transport testing; it does not deliver email.
# EMAIL_TRANSPORT=json
